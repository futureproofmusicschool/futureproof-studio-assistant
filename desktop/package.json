{
  "name": "studio-assistant-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for the studio assistant app",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.studio-assistant.desktop",
    "productName": "Studio Assistant",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music"
    }
  }
}
